node_modules/
dist/
*.log

# local SQLite data when DATA_DIR isn't set (the Fly volume mounts at /data,
# outside the repo, so this only ever appears in a local checkout)
/data/

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Claude Code's project directory is machine-local: settings in here can hold
# your course API key, and this repo goes public when you ship. Your tracked
# harness is CLAUDE.md (and any AGENTS.md), not this directory.
.claude/

# Next.js build output (out/ is served by the game server)
.next/
out/
next-env.d.ts
*.tsbuildinfo
scratch/
